{
  "name": "dsh-nix-dev-shell",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: runs bash commands inside the workspace's Nix dev shell when a flake.nix is present",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "nix",
    "nixos",
    "flake",
    "devshell",
    "bash",
    "sandbox"
  ],
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/running-grass/dsh-nix-dev-shell.git"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "test/selftest.mjs"
  ]
}
